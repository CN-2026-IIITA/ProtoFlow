{
    "name": "protoflow-backend",
    "version": "0.1.0",
    "private": true,
    "type": "commonjs",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "native:build": "node-gyp rebuild --directory native",
        "native:clean": "node-gyp clean --directory native",
        "test": "tsx --test test/**/*.test.ts",
        "prod": "npm run build && npm run native:build && node dist/server.js"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^4.21.2",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.3",
        "@types/node": "^24.0.13",
        "@types/ws": "^8.18.1",
        "node-addon-api": "^8.3.1",
        "node-gyp": "^11.2.0",
        "tsx": "^4.19.4",
        "typescript": "^5.9.2"
    }
}
